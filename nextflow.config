manifest {
  name = 'ELDEN-RING'
  mainScript = 'elden.nf'
  version = '1.0.0'
}

// Install path of the pipeline, passed to every task as $ELDEN_DIR. Task scripts use
// $ELDEN_DIR/scripts/... instead of ${projectDir}/... because Nextflow hashes the values of
// variables a task script references: a re-clone or new revision (new projectDir) would otherwise
// change every task hash and re-run everything on -resume. beforeScript (local runs) and
// containerOptions (containers start with a clean environment) are not part of the hash.
// If you set process.beforeScript or process.containerOptions in your own config, keep these too.
process {
  beforeScript     = "export ELDEN_DIR=${projectDir}"
  containerOptions = "--env ELDEN_DIR=${projectDir}"
}

profiles {
  local    { includeConfig 'conf/profiles/local.config.example' }
  hercules { includeConfig 'conf/profiles/hercules.config.example' }
  edgar    { includeConfig 'conf/profiles/edgar.config.example' }
  contra   { includeConfig 'conf/profiles/contra.config.example' }
  condor   { includeConfig  'conf/profiles/condor.config.example' }
}
